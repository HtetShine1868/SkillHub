# =================================================================
# SUPABASE POSTGRESQL CONFIGURATION EXAMPLE
# =================================================================
# Replace [YOUR_PROJECT_REF] and [YOUR_PASSWORD] with actual values from Supabase:
#
# DB_URL=jdbc:postgresql://db.[YOUR_PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=[YOUR_SUPABASE_DB_PASSWORD]
# =================================================================

DB_URL=jdbc:postgresql://db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# JWT
JWT_SECRET=your_jwt_secret_at_least_32_characters
JWT_EXPIRATION=86400000

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173