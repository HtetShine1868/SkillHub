{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://skillhub-ljz1.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://skillhub-ljz1.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://skillhub-ljz1.onrender.com/login/oauth2/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
